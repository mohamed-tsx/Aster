# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string used by Prisma
DATABASE_URL=postgresql://aster:CHANGE_ME@localhost:5432/aster

# Port the Express server listens on
PORT=5000

NODE_ENV=production

# Comma-separated list of origins allowed by CORS (your frontend URL(s))
CORS_ORIGIN=https://app.example.com

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# Cookie behavior
FORCE_SECURE_COOKIES=true
COOKIE_DOMAIN=.example.com

# Rate limiting (all optional, defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25

# Where uploaded files are stored on disk (optional, defaults inside the repo)
UPLOAD_ROOT=/var/www/aster/Server/uploads
