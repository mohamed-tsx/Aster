# Copy to .env.production and fill in real values before the first `npm run build`.
# NEXT_PUBLIC_* vars are baked into the build, so changes require a rebuild.

# Full backend API URL including the /api/v1 prefix
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Optional: backend root URL (without /api/v1), used for serving uploaded images.
# If omitted, it's derived from NEXT_PUBLIC_API_URL above.
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
